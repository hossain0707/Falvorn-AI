# Required; create via: python -c "import secrets; print(secrets.token_urlsafe(36))"
SOCIAL_API_KEY=CHANGE_ME_TO_RANDOM_STRING_LONGER_THAN_24_CHARS
# SAFE DEFAULT: no actual external posts or messages
SOCIAL_DRY_RUN=true
SOCIAL_DB_PATH=/data/social.db
SOCIAL_MEDIA_DIR=/data/media
# Set only after exposing this app securely over HTTPS (e.g. trusted reverse proxy).
# Public generated assets will be accessible to anyone with the URL.
PUBLIC_MEDIA_URL=
# Optional OpenAI-compatible endpoint for copy and reply drafts
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Official Meta Instagram Professional credentials; configure app, webhooks & scopes
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# LinkedIn approved OAuth posting permission and member/org URN
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202610
# OAuth2 user token with youtube.upload scope; refresh manually (not a token vault)
YOUTUBE_ACCESS_TOKEN=
NEWS_SEARCH_QUERY=artificial intelligence technology
