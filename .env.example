# Set a long, random key before exposing this API on a network.
FALVORN_API_KEY=replace-with-long-random-secret
# OpenAI-compatible chat completions endpoint. Optional: without it, agent runs in read-only snapshot mode.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Self-hosted SearXNG with JSON enabled. Optional; /search returns 503 if not set.
SEARXNG_URL=
# Keep false except isolated local development/testing.
ALLOW_PRIVATE_TARGETS=false
# Agent controls; use tight limits on public deployments.
MAX_AGENT_STEPS=12
MAX_ACTIVE_BROWSERS=3
MAX_PAGE_BYTES=1000000
BROWSER_HEADLESS=true
DATA_DIR=./data

# Optional: scheduled change checks. Keep off when multiple API workers are used.
# This does not send notifications or run when your computer is shut down.
MONITOR_SCHEDULER_ENABLED=false
